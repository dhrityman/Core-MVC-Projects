@*  Give the reference of the ChangePasswordViewModel class in the UserRoles.ViewModels namespace.*@
@using UserRoles.ViewModels;
@*
    The ChangePassword.cshtml file is a Razor view that represents the change password page in an ASP.NET Core application.
    It is typically used to allow users to change their password after verifying their email address.
    Register the model name as ChangePasswordViewModel to use it in the view.
*@
@model ChangePasswordViewModel;
@*
    The ViewData dictionary is used to pass data from the controller to the view. In this case, we are setting the "Title" key in the ViewData dictionary to "Change Password".
    This value can be accessed in the layout or other parts of the view to display the title of the page.
    
    Lauout is set to the _AccountLayout.cshtml file, which provides a consistent look and feel for account-related pages.
*@
@{
    ViewData["Title"] = "Change Password";
    Layout = "~/Views/Shared/_AccountLayout.cshtml";
}
@*
    The form uses Bootstrap classes for styling and layout.
    Validation messages are displayed in red to indicate errors.
*@
<div class="account-container">
    <div class="account-box">
        @* The heading "Change Password" is displayed at the top of the form, centered and with a margin at the bottom.*@
        <h2 class="text-center mb-4">Change Password</h2>
        @*
            The form includes fields for email, new password, and confirm new password.
            It also includes validation messages for each field.
            The form uses the POST method to submit the change password request to the server.
            The asp-action attribute specifies that the form should be submitted to the ChangePassword action in the Account controller.

            Html.AntiForgeryToken():=> Generates a hidden anti-forgery token field to protect against cross-site request forgery (CSRF) attacks.
        *@       
        <form asp-action="ChangePassword" method="post">
            @Html.AntiForgeryToken()
            @*
                The asp-validation-summary attribute is used to display validation errors for the model.
                The ModelOnly option indicates that only model-level errors should be displayed, not property-level errors.
            *@
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            @*
                The asp-for attribute is used to bind the input fields to the properties of the ChangePasswordViewModel.
                The form includes labels and input fields for email, new password, and confirm new password.
            *@
            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" readonly />
            </div>
            @*
                The asp-for attribute is used to bind the input fields to the properties of the ChangePasswordViewModel.
                The form includes labels and input fields for NewPassword, new password, and confirm new password.
            *@
            <div class="mb-3">
                <label asp-for="NewPassword" class="form-label"></label>
                <input asp-for="NewPassword" class="form-control" />
                <span asp-validation-for="NewPassword" class="text-danger"></span>
            </div>
            @*
                The asp-for attribute is used to bind the input fields to the properties of the ChangePasswordViewModel.
                The form includes labels and input fields for ConfirmNewPassword, new password, and confirm new password.
            *@
            <div class="mb-3">
                <label asp-for="ConfirmNewPassword" class="form-label"></label>
                <input asp-for="ConfirmNewPassword" class="form-control" />
                <span asp-validation-for="ConfirmNewPassword" class="text-danger"></span>
            </div>
            @*
                The input type="submit" element is used to create a submit button for the form.
                When clicked, it will submit the form data to the server for processing.
                The class attributes "btn btn-success w-100 p-2" are Bootstrap classes that style the button with a green color, full width, and padding.
            *@
            <input type="submit" value="Submit" class="btn btn-success w-100 p-2" />
            @*
                The "Back" link directs users to the VerifyEmail action in the Account controller.
                This allows users to go back to the previous page if they want to cancel the password change process.
            *@
            <div class="text-center mt-2">
                <a asp-controller="Account" asp-action="VerifyEmail" class="text-decoration-none mt-3">Back</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial.cshtml");
    }
}